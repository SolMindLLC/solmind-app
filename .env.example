# SolMind MVP0 environment example
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# Public browser-safe Supabase values.
# NEXT_PUBLIC_ variables are exposed to browser/client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only bootstrap value for first Admin setup.
# Do not prefix this with NEXT_PUBLIC_.
SOLMIND_BOOTSTRAP_TOKEN=

# Server-only Supabase service role key.
# Do not use this in client components, browser code, or NEXT_PUBLIC_ variables.
# Do not enable this until server-only Supabase admin workflows exist.
SUPABASE_SERVICE_ROLE_KEY=

SOLMIND_TRUSTED_APP_ORIGIN=

# Server-only verification-code pepper (AUTH-RLS-DEC-032). The sign-in
# routes will need it once they are switched on: 32 random bytes written as
# base64url text with no padding (43 characters; up to 64 bytes, or 86
# characters, is accepted). Do not prefix it with NEXT_PUBLIC_, never commit
# a value, and never print or log it. Each environment has its own value.
# Changing it makes every open verification code unusable, so people ask
# for a new code.
SOLMIND_VERIFICATION_PEPPER=

# Optional server-only exact-pair proof key for bounded logout renewal.
# Use a dedicated independent random key: 32 to 4096 bytes, represented as
# canonical padded RFC 4648 base64 (not base64url). Never use NEXT_PUBLIC_,
# reuse the verification pepper/provider keys, commit a value, or log it.
# This example creates/configures no key. Missing or invalid configuration
# disables proof minting and proof-authorized logout renewal; it does not
# disable normal sign-in checks or suitable existing-token local cleanup.
# Replacing the key makes older proofs unverifiable; no incoming cookie is
# upgraded into a new proof. The next-login backstop never renews.
SOLMIND_CREDENTIAL_PAIR_PROOF_KEY_BASE64=
